{
  "name": "where-are-you-server",
  "version": "0.0.1",
  "description": "Backend for Where Are You? service",
  "license": "GPL-3.0",
  "author": "Dallin Kooyman",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "build": "npm run lint:fix && npm run format && tsc -b",
    "start": "npm run build && node dist/index.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jiti": "^2.7.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.9.4",
    "redis": "^6.3.0",
    "uuid": "^14.0.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.20",
    "@types/node": "^20.5.9",
    "@types/ws": "^8.5.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.69.0"
  }
}
